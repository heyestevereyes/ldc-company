# Resend (https://resend.com) — API key para enviar los correos del
# formulario de contacto (app/api/contact/route.ts).
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario de contacto.
CONTACT_EMAIL_TO=

# Sanity (https://sanity.io) — proyecto que alimenta el contenido editorial
# del sitio (hero, proyectos de Trayectoria, footer) vía lib/sanity/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token con permisos de escritura ("Editor"), solo necesario para correr
# scripts/migrate-sanity-content.ts. Generar en sanity.io/manage → proyecto
# → API → Tokens.
SANITY_API_TOKEN=

# Secreto del webhook de Sanity que dispara app/api/revalidate/route.ts.
SANITY_REVALIDATE_SECRET=
